<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Scrinium" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Scrinium">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200 text-base-content">
    <main class="flex min-h-screen flex-col">
      <% if Current.user %>
        <header class="navbar min-h-16 border-b border-base-300 bg-base-100 px-4">
          <div class="flex-1">
            <%= link_to root_path, class: "flex items-center gap-3 text-xl font-bold" do %>
              <span class="grid size-10 place-items-center rounded-lg bg-primary text-primary-content">
                <%= lucide_icon("book-open", "class" => "size-5") %>
              </span>
              <span>Scrinium</span>
            <% end %>
          </div>

          <div class="flex-none">
            <%= button_to session_path, method: :delete, class: "btn btn-ghost" do %>
              <%= lucide_icon("log-out", "class" => "size-4") %>
              Sign out
            <% end %>
          </div>
        </header>
      <% end %>

      <div class="flex flex-1">
        <% if Current.user %>
          <aside class="hidden w-64 shrink-0 border-r border-base-300 bg-base-100 p-4 lg:flex lg:flex-col">
            <nav class="menu gap-1 p-0 text-base">
              <li>
                <%= link_to root_path, class: current_page?(root_path) ? "active" : nil do %>
                  <%= lucide_icon("library", "class" => "size-4") %>
                  Library
                <% end %>
              </li>
              <% if Current.user.admin? %>
                <li>
                  <%= link_to admin_root_path, class: request.path.start_with?("/admin") ? "active" : nil do %>
                    <%= lucide_icon("settings", "class" => "size-4") %>
                    Admin
                  <% end %>
                </li>
              <% end %>
            </nav>
          </aside>
        <% end %>

        <section class="min-w-0 flex-1">
          <div class="space-y-4 p-4 sm:p-6 lg:p-8">
            <% flash.each do |type, message| %>
              <div class="alert <%= type == "alert" ? "alert-error" : "alert-success" %>">
                <span><%= message %></span>
              </div>
            <% end %>

            <%= yield %>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
