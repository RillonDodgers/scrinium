<% if books.any? %>
  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Author</th>
          <th>Series</th>
          <th>Files</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% books.each do |book| %>
          <tr>
            <td><%= book.title %></td>
            <td><%= book.author.name %></td>
            <td><%= book.series&.name || "None" %></td>
            <td>
              <div class="flex flex-wrap gap-1">
                <% book.book_files.each do |book_file| %>
                  <span class="badge <%= book_file.status_missing? ? "badge-error" : "badge-outline" %>"><%= book_file.format %></span>
                <% end %>
              </div>
            </td>
            <td><%= link_to "Open", admin_library_book_path(library, book), class: "btn btn-sm btn-ghost" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="opacity-70">No books indexed.</p>
<% end %>
