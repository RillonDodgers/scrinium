<div class="w-full space-y-6">
  <%= render "admin/shared/page_header", title: "Libraries", eyebrow: "Admin", actions: link_to("New library", new_admin_library_path, class: "btn btn-primary") %>

  <% if @libraries.any? %>
    <div class="grid gap-4">
      <% @libraries.each do |library| %>
        <div class="card bg-base-100 shadow">
          <div class="card-body">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h2 class="card-title"><%= library.name %></h2>
                <p class="text-sm opacity-70"><%= library.root_path %></p>
              </div>
              <div class="card-actions">
                <%= link_to "Open", admin_library_path(library), class: "btn btn-primary" %>
                <%= link_to "Edit", edit_admin_library_path(library), class: "btn btn-ghost" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="hero bg-base-200 rounded-box">
      <div class="hero-content text-center">
        <div>
          <h2 class="text-2xl font-bold">No libraries yet</h2>
          <p class="py-4">Add local book directory to start indexing EPUB and M4B files.</p>
          <%= link_to "New library", new_admin_library_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
