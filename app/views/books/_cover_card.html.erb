<% book = book_file.book %>

<article class="group min-w-0">
  <%= render "books/cover", book_file:, cover_classes: "transition group-hover:-translate-y-0.5 group-hover:shadow-lg" %>

  <h3 class="mt-3 truncate text-sm font-semibold"><%= book.title %></h3>
  <p class="mt-1 truncate text-xs opacity-70"><%= book.author.name %></p>
</article>
