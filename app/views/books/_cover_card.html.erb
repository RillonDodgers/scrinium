<article class="group min-w-0">
  <%= link_to book_path(book), class: "block" do %>
    <%= render "books/cover", book_file: book.preferred_cover_file, book:, cover_classes: "transition group-hover:-translate-y-0.5 group-hover:shadow-lg" %>
  <% end %>

  <div class="mt-3 flex min-w-0 items-center gap-2">
    <h3 class="min-w-0 flex-1 truncate text-sm font-semibold"><%= link_to book.title, book_path(book) %></h3>
    <% book.available_formats.each do |format| %>
      <span class="badge badge-outline badge-xs uppercase"><%= format %></span>
    <% end %>
  </div>
  <p class="mt-1 truncate text-xs opacity-70"><%= book.author.name %></p>
</article>
