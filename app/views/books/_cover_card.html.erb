<% book = book_file.book %>

<article class="group min-w-0">
  <%= render "books/cover", book_file:, cover_classes: "transition group-hover:-translate-y-0.5 group-hover:shadow-lg" %>

  <div class="mt-3 flex min-w-0 items-center gap-2">
    <h3 class="min-w-0 flex-1 truncate text-sm font-semibold"><%= book.title %></h3>
    <span class="badge badge-outline badge-xs uppercase"><%= book_file.format %></span>
  </div>
  <p class="mt-1 truncate text-xs opacity-70"><%= book.author.name %></p>
</article>
