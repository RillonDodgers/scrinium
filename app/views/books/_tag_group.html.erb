<section class="space-y-3">
  <h2 class="text-2xl font-semibold"><%= title %></h2>

  <% if tags.any? %>
    <div class="flex flex-wrap gap-2">
      <% tags.each do |book_metadata_tag| %>
        <% tag = book_metadata_tag.metadata_tag %>
        <% if reveal %>
          <details class="dropdown">
            <summary class="badge badge-warning cursor-pointer">Reveal</summary>
            <span class="badge badge-warning mt-2"><%= tag.name %></span>
          </details>
        <% else %>
          <span class="badge badge-outline"><%= tag.name %></span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm opacity-60">No <%= title.downcase %> stored.</p>
  <% end %>
</section>
